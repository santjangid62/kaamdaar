{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Client — Kaamdaar web app (next dev :3100)",
      "type": "shell",
      "command": "npm run dev -- -p 3100 2>&1 | tee .dev.log",
      "options": {
        "shell": {
          "executable": "bash",
          "args": []
        }
      },
      "group": { "kind": "build", "isDefault": true },
      "presentation": {
        "panel": "dedicated",
        "group": "client",
        "reveal": "always",
        "clear": true,
        "showReuseMessage": false,
        "close": false
      },
      "problemMatcher": []
    },
