# Copy to .env.local and fill in what you need. Notes:
#   - Local development may use the JSON file store and dev OTP. Production requires Firebase + MongoDB + secure Admin credentials.
#   - PostHog is optional: with no values no analytics is sent at all.

# Firebase (Phone Auth + Firestore). Register a separate Web app in Firebase Console
# and copy its Web App ID into NEXT_PUBLIC_FIREBASE_APP_ID.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# PostHog product analytics (browser SDK, initialised in src/instrumentation-client.ts)
# Token: the project's PUBLIC project token from PostHog project settings — never a personal API key.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
# Ingestion host: https://us.i.posthog.com (US), https://eu.i.posthog.com (EU)
# or your self-hosted ingestion domain. Empty means analytics stays off.
NEXT_PUBLIC_POSTHOG_HOST=

# Firebase Cloud Messaging (server-side; never commit the service-account JSON)
FIREBASE_PROJECT_ID=
# Paste the complete service-account JSON as a single-line JSON value in Vercel.
FIREBASE_SERVICE_ACCOUNT_JSON=

# MongoDB Atlas — set this in Vercel (Settings → Environment Variables) for real persistence
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"

# Super Admin — mandatory in production. Use a unique strong password and a random 32+ character session secret.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
