# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# local database
/.data/

# flutter SDK (installed locally for the mobile apps)
.flutter-sdk/
.flutter-install.log
.flutter-version.log

# local run logs
/.logs/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (templates are committed, real secrets never are)
.env*
!.env.example
!.env.local.example

# local dev log
.dev.log
.wrangler-dev.log

# Freebuff platform runtime state
.freebuff/

# vercel
.vercel

# flutter build output and caches (source only)
/apps/*/build/
/apps/*/.dart_tool/
/apps/*/.flutter-plugins
/apps/*/.flutter-plugins-dependencies
/apps/*/android/.gradle/
/apps/*/android/local.properties
/apps/*/ios/Pods/
/apps/*/ios/.symlinks/

# local verification screenshots and one-off logs
/*.png
/screenshots/
.flutter-create.log

# typescript
*.tsbuildinfo
next-env.d.ts
/freebuff-sites-build/
/.open-next/
/.wrangler/
.vercel
